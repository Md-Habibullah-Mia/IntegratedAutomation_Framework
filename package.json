{
  "name": "unified-automation-framework",
  "version": "1.0.0",
  "description": "Scalable cross-platform (web + mobile + API) test automation framework",
  "scripts": {
    "test:web": "playwright test --config=playwright.config.ts",
    "test:web:medco": "playwright test --config=playwright.config.ts --project=medco-*",
    "test:web:massive-market": "playwright test --config=playwright.config.ts --project=massive-market-*",
    "test:web:headed": "playwright test --config=playwright.config.ts --headed",
    "test:web:ui": "playwright test --config=playwright.config.ts --ui",
    "test:mobile": "wdio run wdio.conf.ts",
    "test:api": "playwright test --config=playwright.api.config.ts",
    "test:all": "npm run test:web && npm run test:api && npm run test:mobile",
    "report:web": "playwright show-report",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/chai": "^4.3.20",
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^3.9.0",
    "appium-xcuitest-driver": "^7.30.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.10.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
